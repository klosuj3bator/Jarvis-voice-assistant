# Zwykle NIE musisz tworzyć .env — klucze wpiszesz w kreatorze przy pierwszym
# uruchomieniu (zapis w %APPDATA%\Jarvis\config.env). Ten plik dalej działa,
# a Ustawienia mają przed nim pierwszeństwo (opis w konfiguracja.py).

SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
ANTHROPIC_API_KEY=

# Opcjonalnie: Telegram
TELEGRAM_JARVIS_TOKEN=
TELEGRAM_OWNER_ID=

# Opcjonalnie: Gmail — do trzech kont (hasło aplikacji, nie zwykłe hasło).
# Nazwą konta jest część adresu przed "@"; w GMAIL_n_NAME dopisz własne nazwy,
# po przecinku (np. "praca, firma"). Bez wskazania konta Jarvis sprawdza wszystkie.
GMAIL_1_NAME=
GMAIL_1_ADDRESS=
GMAIL_1_APP_PASSWORD=
# GMAIL_2_NAME=praca
# GMAIL_2_ADDRESS=
# GMAIL_2_APP_PASSWORD=
# (GMAIL_3_* analogicznie)
# GMAIL_DOMYSLNE=1        — numer albo nazwa konta domyślnego ("główne konto")
# Stary zapis z jednym kontem (GMAIL_ADDRESS, GMAIL_APP_PASSWORD) dalej działa jako konto 1.

# Opcjonalnie: kalendarz Google.
# Główna droga to Google Calendar API (czytanie i dodawanie wydarzeń): zapisz plik
# klienta OAuth jako google_credentials.json w folderze Jarvisa i kliknij
# Ustawienia → Klucze API → Kalendarz Google → "Połącz z Google" (token trafi do
# google_token.json). Oba pliki są w .gitignore.
# Tajny adres iCal to zapas tylko do odczytu, gdy API nie działa — traktuj go jak hasło.
GOOGLE_CALENDAR_ICAL_URL=
# Ile minut przed wydarzeniem Jarvis przypomina (głosem i na Telegramie); 0 = bez przypomnień.
JARVIS_PRZYPOMNIENIE_KALENDARZA_MIN=30

# Opcjonalnie: vault Obsidiana — Jarvis przeszukuje go razem z notatkami głosowymi
# ("co zanotowałem o…"). Wszystko lokalnie: notatki nie wychodzą z komputera.
OBSIDIAN_VAULT_PATH=

# Opcjonalnie: foldery, w których Jarvis może tworzyć, zmieniać i przenosić pliki
# ("zrób folder Projekty na pulpicie"), rozdzielone średnikiem. Puste = Pulpit i Dokumenty.
# Jarvis nigdy nie usuwa plików i nie rusza własnego folderu.
# JARVIS_DOZWOLONE_FOLDERY=C:\Users\Ty\Desktop;D:\Projekty
JARVIS_DOZWOLONE_FOLDERY=

# Opcjonalnie: nasłuch (Ustawienia → Nasłuch).
# Przez kilka minut po starcie wystarczy "hej, wróciłem" / "cześć Jarvis" / "jestem" — bez
# "Hey Jarvis". 0 wyłącza; czas okienka w minutach (1–60).
JARVIS_POWITANIE_PO_STARCIE=1
JARVIS_OKNO_POWITANIA_MIN=10
# Próg czułości słowa aktywującego (0.05–0.95). Puste = automatycznie: 0.2 dla "Hey Jarvis",
# 0.5 dla własnego modelu z models/jarvis.onnx. Niższy = łatwiej zawołać, ale częściej sam się odezwie.
JARVIS_PROG_WAKE_WORDA=

# Opcjonalnie: tryb roadmapy (Ustawienia → Ogólne) — propozycje zadań z MapaZadan.md na
# Telegramie, praca na gałęzi roadmap, /scal do main. 1 = włączony; raport codziennie o tej godzinie.
JARVIS_ROADMAPA=0
JARVIS_ROADMAPA_RAPORT=12:00
# Modele Claude Code (/kod i roadmapa): do zadań trudnych i łatwych (trudność w MapaZadan.md).
# claude-opus-5-5, claude-opus-5, claude-sonnet-5-5, claude-sonnet-5, claude-haiku-5-5
JARVIS_CLAUDE_MODEL_TRUDNE=claude-opus-5-5
JARVIS_CLAUDE_MODEL_LATWE=claude-sonnet-5-5

# Opcjonalnie: jak Jarvis ma się do Ciebie zwracać ("Hej Jarvis, wróciłem").
# Bez tego bierze imię z końca JARVIS_POWITANIE (np. "Witaj Macieju") albo z pamięci.
JARVIS_IMIE=
