# Zwykle NIE musisz tworzyć .env — klucze wpiszesz w kreatorze przy pierwszym
# uruchomieniu (zapis w %APPDATA%\Jarvis\config.env). Ten plik dalej działa,
# a Ustawienia mają przed nim pierwszeństwo (opis w konfiguracja.py).

SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
ANTHROPIC_API_KEY=

# Opcjonalnie: Telegram
TELEGRAM_JARVIS_TOKEN=
TELEGRAM_OWNER_ID=

# Opcjonalnie: Gmail (hasło aplikacji, nie zwykłe hasło)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Opcjonalnie: kalendarz Google (tajny adres w formacie iCal — traktuj jak hasło)
GOOGLE_CALENDAR_ICAL_URL=
