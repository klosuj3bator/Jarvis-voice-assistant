# Zwykle NIE musisz tworzyć .env — klucze wpiszesz w kreatorze przy pierwszym
# uruchomieniu (zapis w %APPDATA%\Jarvis\config.env). Ten plik dalej działa,
# a Ustawienia mają przed nim pierwszeństwo (opis w konfiguracja.py).

SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
ANTHROPIC_API_KEY=

# Opcjonalnie: Telegram
TELEGRAM_JARVIS_TOKEN=
TELEGRAM_OWNER_ID=

# Opcjonalnie: Gmail — do trzech kont (hasło aplikacji, nie zwykłe hasło).
# Nazwą konta jest część adresu przed "@"; w GMAIL_n_NAME dopisz własne nazwy,
# po przecinku (np. "praca, firma"). Bez wskazania konta Jarvis sprawdza wszystkie.
GMAIL_1_NAME=
GMAIL_1_ADDRESS=
GMAIL_1_APP_PASSWORD=
# GMAIL_2_NAME=praca
# GMAIL_2_ADDRESS=
# GMAIL_2_APP_PASSWORD=
# (GMAIL_3_* analogicznie)
# GMAIL_DOMYSLNE=1        — numer albo nazwa konta domyślnego ("główne konto")
# Stary zapis z jednym kontem (GMAIL_ADDRESS, GMAIL_APP_PASSWORD) dalej działa jako konto 1.

# Opcjonalnie: kalendarz Google (tajny adres w formacie iCal — traktuj jak hasło)
GOOGLE_CALENDAR_ICAL_URL=

# Opcjonalnie: vault Obsidiana — Jarvis przeszukuje go razem z notatkami głosowymi
# ("co zanotowałem o…"). Wszystko lokalnie: notatki nie wychodzą z komputera.
OBSIDIAN_VAULT_PATH=

# Opcjonalnie: foldery, w których Jarvis może tworzyć, zmieniać i przenosić pliki
# ("zrób folder Projekty na pulpicie"), rozdzielone średnikiem. Puste = Pulpit i Dokumenty.
# Jarvis nigdy nie usuwa plików i nie rusza własnego folderu.
# JARVIS_DOZWOLONE_FOLDERY=C:\Users\Ty\Desktop;D:\Projekty
JARVIS_DOZWOLONE_FOLDERY=

# Opcjonalnie: jak Jarvis ma się do Ciebie zwracać ("Hej Jarvis, wróciłem").
# Bez tego bierze imię z końca JARVIS_POWITANIE (np. "Witaj Macieju") albo z pamięci.
JARVIS_IMIE=
